# SMART Reporting System - Production Environment Configuration
# ⚠️  SECURITY: Change all values before deploying to production!

# ── Core Django Settings ──────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=CHANGE_ME_TO_A_STRONG_SECRET_KEY_IN_PRODUCTION
ALLOWED_HOSTS=pbpa-smart-inspection-system.onrender.com,.onrender.com
CSRF_TRUSTED_ORIGINS=https://pbpa-smart-inspection-system-3dr7.onrender.com,https://pbpa-smart-inspection-system.onrender.com

# ── Database Configuration ────────────────────────────────────────────────────
# Use environment-specific database URLs
# PostgreSQL Format: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=postgresql://db_user:CHANGE_ME_PASSWORD@postgres.example.com:5432/petroleum_db

# ── Frontend Configuration ────────────────────────────────────────────────────
FRONTEND_HOST=pbpa-smart-inspection-system-3dr7.onrender.com
FRONTEND_URL=https://pbpa-smart-inspection-system-3dr7.onrender.com
BACKEND_HOST=pbpa-smart-inspection-system.onrender.com
REACT_APP_API_URL=https://pbpa-smart-inspection-system.onrender.com/api

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://pbpa-smart-inspection-system-3dr7.onrender.com

# ── JWT Token Settings ────────────────────────────────────────────────────────
# Access token lifetime in minutes
JWT_ACCESS_TOKEN_LIFETIME=15
# Refresh token lifetime in days
JWT_REFRESH_TOKEN_LIFETIME=7

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Format: requests/time_period (e.g., 30/minute, 100/hour)
THROTTLE_ANON_RATE=30/minute
THROTTLE_USER_RATE=300/minute
THROTTLE_LOGIN_RATE=5/minute
THROTTLE_REGISTER_RATE=3/hour

# ── Email Configuration (for alerts and notifications) ────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME_TO_APP_PASSWORD
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# ── Logging Configuration ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to true for detailed debugging (ONLY in development)
VERBOSE_LOGGING=false

# ── File Upload Configuration ─────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=2.5
ALLOWED_UPLOAD_EXTENSIONS=pdf,xlsx,csv,jpg,jpeg,png

# ── Security Settings ────────────────────────────────────────────────────────
# Enforce HTTPS in production
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# ── Redis Configuration (for caching and session storage) ──────────────────────
REDIS_URL=redis://:PASSWORD@redis.example.com:6379/0

# ── AWS S3 Configuration (for media storage) ──────────────────────────────────
# Optional: Use for production to store uploaded files
USE_S3=false
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# ── New Relic Monitoring (Optional) ───────────────────────────────────────────
NEW_RELIC_CONFIG_FILE=newrelic.ini
NEW_RELIC_ENVIRONMENT=production
NEW_RELIC_LICENSE_KEY=CHANGE_ME

# ── Sentry Error Tracking (Optional) ──────────────────────────────────────────
SENTRY_DSN=https://your-sentry-key@sentry.io/your-project-id
