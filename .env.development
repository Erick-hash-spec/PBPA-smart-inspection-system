# SMART Reporting System - Development Environment Configuration
# Use this for local development - NOT for production

DEBUG=true
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Local database (SQLite or PostgreSQL)
# For SQLite: sqlite:///db.sqlite3
# For PostgreSQL: postgresql://postgres:password@localhost:5432/petroleum_db
DATABASE_URL=sqlite:///db.sqlite3

FRONTEND_HOST=localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_HOST=localhost:8000
REACT_APP_API_URL=http://localhost:8000/api

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

JWT_ACCESS_TOKEN_LIFETIME=30
JWT_REFRESH_TOKEN_LIFETIME=1

THROTTLE_ANON_RATE=1000/minute
THROTTLE_USER_RATE=10000/minute
THROTTLE_LOGIN_RATE=100/minute
THROTTLE_REGISTER_RATE=100/hour

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=dev@localhost

LOG_LEVEL=DEBUG
VERBOSE_LOGGING=true

MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,xlsx,csv,jpg,jpeg,png

SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Redis is optional for development
REDIS_URL=redis://localhost:6379/0
